{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ToolInvocationRequested",
  "type": "object",
  "properties": {
    "conversationId": {
      "type": "string",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
    },
    "timestamp": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "eventType": {
      "type": "string",
      "const": "ToolInvocationRequested"
    },
    "payload": {
      "type": "object",
      "properties": {
        "toolName": {
          "type": "string",
          "enum": [
            "weather",
            "exchange",
            "math",
            "chat",
            "getProductInformation"
          ]
        },
        "stepIndex": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991,
          "description": "Index of the plan step this request executes."
        },
        "input": {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {}
        }
      },
      "required": [
        "toolName",
        "stepIndex",
        "input"
      ]
    }
  },
  "required": [
    "conversationId",
    "timestamp",
    "eventType",
    "payload"
  ],
  "title": "ToolInvocationRequested",
  "description": "The orchestrator asks one tool worker to run one plan step. Topic: tool-invocation-requests. Producer: orchestrator. Consumers: the math, weather, exchange and chat workers and the Python rag_retriever; each handles its own toolName."
}
