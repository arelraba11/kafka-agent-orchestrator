{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "PlanFailed",
  "type": "object",
  "properties": {
    "conversationId": {
      "type": "string",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
    },
    "timestamp": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "eventType": {
      "type": "string",
      "const": "PlanFailed"
    },
    "payload": {
      "type": "object",
      "properties": {
        "reason": {
          "type": "string"
        },
        "failedTool": {
          "type": "string",
          "description": "The tool whose step failed, or \"none\" for a plan with no steps."
        },
        "completedResults": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "toolName": {
                "type": "string",
                "enum": [
                  "weather",
                  "exchange",
                  "math",
                  "chat",
                  "getProductInformation"
                ]
              },
              "result": {
                "type": "object",
                "propertyNames": {
                  "type": "string"
                },
                "additionalProperties": {}
              }
            },
            "required": [
              "toolName",
              "result"
            ]
          }
        }
      },
      "required": [
        "reason",
        "failedTool",
        "completedResults"
      ]
    }
  },
  "required": [
    "conversationId",
    "timestamp",
    "eventType",
    "payload"
  ],
  "title": "PlanFailed",
  "description": "A plan could not finish (a tool returned an error, or the plan was empty). Topic: conversation-events. Producer: orchestrator. Consumer: webServer."
}
