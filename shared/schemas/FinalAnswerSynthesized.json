{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "FinalAnswerSynthesized",
  "type": "object",
  "properties": {
    "conversationId": {
      "type": "string",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
    },
    "timestamp": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "eventType": {
      "type": "string",
      "const": "FinalAnswerSynthesized"
    },
    "payload": {
      "type": "object",
      "properties": {
        "answer": {
          "type": "string",
          "pattern": "\\S"
        }
      },
      "required": [
        "answer"
      ]
    }
  },
  "required": [
    "conversationId",
    "timestamp",
    "eventType",
    "payload"
  ],
  "title": "FinalAnswerSynthesized",
  "description": "The LLM-written answer for a conversation. The answer must contain a non-whitespace character; an empty LLM answer is reported as a ConversationFailed instead. Topic: conversation-events. Producer: answerSynthesizer. Consumer: webServer."
}
