{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ToolInvocationResulted",
  "type": "object",
  "properties": {
    "conversationId": {
      "type": "string",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
    },
    "timestamp": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "eventType": {
      "type": "string",
      "const": "ToolInvocationResulted"
    },
    "payload": {
      "type": "object",
      "properties": {
        "toolName": {
          "type": "string",
          "enum": [
            "weather",
            "exchange",
            "math",
            "chat",
            "getProductInformation"
          ]
        },
        "stepIndex": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991,
          "description": "Echo of ToolInvocationRequested.payload.stepIndex."
        },
        "result": {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {},
          "description": "Open record. An `error` string marks the step as failed. `value` is the scalar a downstream `{{step_N.result}}` resolves to; the RAG worker sets it to the product price in USD, digits only, when known."
        }
      },
      "required": [
        "toolName",
        "stepIndex",
        "result"
      ]
    }
  },
  "required": [
    "conversationId",
    "timestamp",
    "eventType",
    "payload"
  ],
  "title": "ToolInvocationResulted",
  "description": "A tool worker finished one plan step. Topic: conversation-events. Producers: the math, weather, exchange and chat workers and the Python rag_retriever. Consumers: orchestrator (advances the plan), webServer (progress frame)."
}
