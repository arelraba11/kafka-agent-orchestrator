{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "UserQueryReceived",
  "type": "object",
  "properties": {
    "conversationId": {
      "type": "string",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
    },
    "timestamp": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "eventType": {
      "type": "string",
      "const": "UserQueryReceived"
    },
    "payload": {
      "type": "object",
      "properties": {
        "userInput": {
          "type": "string",
          "minLength": 1
        },
        "sessionId": {
          "type": "string"
        }
      },
      "required": [
        "userInput",
        "sessionId"
      ]
    }
  },
  "required": [
    "conversationId",
    "timestamp",
    "eventType",
    "payload"
  ],
  "title": "UserQueryReceived",
  "description": "A user typed a query. Topic: user-commands. Producer: webServer. Consumers: routerService (plans it), answerSynthesizer (caches it)."
}
