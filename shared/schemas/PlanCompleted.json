{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "PlanCompleted",
  "type": "object",
  "properties": {
    "conversationId": {
      "type": "string",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
    },
    "timestamp": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "eventType": {
      "type": "string",
      "const": "PlanCompleted"
    },
    "payload": {
      "type": "object",
      "properties": {
        "results": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "toolName": {
                "type": "string",
                "enum": [
                  "weather",
                  "exchange",
                  "math",
                  "chat",
                  "getProductInformation"
                ]
              },
              "result": {
                "type": "object",
                "propertyNames": {
                  "type": "string"
                },
                "additionalProperties": {}
              }
            },
            "required": [
              "toolName",
              "result"
            ]
          }
        }
      },
      "required": [
        "results"
      ]
    },
    "sessionId": {
      "type": "string"
    }
  },
  "required": [
    "conversationId",
    "timestamp",
    "eventType",
    "payload",
    "sessionId"
  ],
  "title": "PlanCompleted",
  "description": "Every step of a plan produced a result. Topic: conversation-events. Producer: orchestrator. Consumer: aggregator."
}
