# Copy to .env. Every variable below is optional except an LLM choice (see "LLM").
# Optional settings are commented out and show their default, so copying this file
# unchanged does not change behavior.
#
# These values reach the Node services (Bun loads .env) and, through `bun run start`,
# the Python RAG worker, which inherits the environment of start.ts. Running
# `python src/python/rag/rag_retriever.py` by hand does NOT read .env: export the
# variables in that shell instead.
# Test-only variables are documented in the README (Testing), not here.

# ─── LLM ──────────────────────────────────────────────────────────────────────
# LLM_PROVIDER picks the provider chain:
#   auto   → one Ollama attempt, then OpenAI with the remaining budget (code default)
#   ollama → Ollama only
#   openai → OpenAI only (recommended: the default Ollama model plans multi-step
#            queries poorly; Ollama is a keyless local option)
LLM_PROVIDER=auto

# Needed only when the provider chain reaches OpenAI: LLM_PROVIDER=openai, or
# LLM_PROVIDER=auto when Ollama fails. The client is created on first use, so every
# service starts without a key. Without one, a call that reaches OpenAI fails with
# "OPENAI_API_KEY is not set" and the user sees "language model is misconfigured".
# With LLM_PROVIDER=ollama no key is needed.
# Get yours at: https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here

# Optional: any OpenAI-compatible endpoint (read by the OpenAI SDK).
# OPENAI_BASE_URL=https://api.openai.com/v1

# Ollama (started by infra/docker-compose.yml). Used by auto and ollama.
# OLLAMA_HOST=http://localhost:11434
# Defaults to llama3.2:1b in code when unset (DEFAULT_OLLAMA_MODEL).
# OLLAMA_MODEL=llama3.2:1b

# Per-attempt timeout for one LLM request, in ms. Each caller also has an overall
# budget; an attempt never outlives what is left of it.
# LLM_ATTEMPT_TIMEOUT_MS=20000
# Overall budget per call, in ms. The router makes one attempt; the synthesizer up to three.
# LLM_ROUTER_BUDGET_MS=15000
# LLM_SYNTH_BUDGET_MS=60000

# ─── Pipeline ─────────────────────────────────────────────────────────────────
# How long a dispatched tool step may go unanswered before the plan fails with
# "The <tool> tool didn't respond within <n> s". One global value, in ms.
# STEP_TIMEOUT_MS=30000

# ─── Kafka ────────────────────────────────────────────────────────────────────
# Comma-separated broker list (read by the Node services and the Python worker).
# KAFKA_BROKERS=localhost:9092
# Prefix for every topic and consumer group (used by the integration suite).
# KAFKA_NAMESPACE=
# earliest | latest: where a consumer group with no committed offset starts.
# KAFKA_OFFSET_RESET=latest
# Consumer group timeouts, in ms (kafkajs / kafka-python defaults when unset).
# KAFKA_SESSION_TIMEOUT_MS=30000
# KAFKA_HEARTBEAT_INTERVAL_MS=3000
# KAFKA_REBALANCE_TIMEOUT_MS=60000
# Consumer fetch long-poll, in ms (kafkajs maxWaitTimeInMs). Keep it well below the session
# timeout: kafkajs sends heartbeats between fetches, so a wait longer than the session makes
# an idle member expire and rebalance.
# KAFKA_MAX_WAIT_MS=5000
# Client retries and request timeout in ms (library defaults when unset).
# KAFKA_RETRIES=10
# KAFKA_REQUEST_TIMEOUT_MS=30000
# RAG worker (kafka-python) producer: how long send() waits for topic metadata, in ms. A worker
# that has not sent to a topic yet blocks this long on a down broker before it exits.
# KAFKA_MAX_BLOCK_MS=60000
# Seconds the RAG worker waits for a result send to be acknowledged.
# RAG_SEND_TIMEOUT_S=10

# ─── State and ports ──────────────────────────────────────────────────────────
# PLAN_STORE_PATH=.plan-store
# SYNTH_STORE_PATH=.synth-store
# HISTORY_PATH=history.json
# WEB_PORT=3001

# ─── Process management ───────────────────────────────────────────────────────
# Where `bun run start` / the supervisor / `bun run stop` keep pid files and service logs.
# Set both to run a second, separate copy (e.g. in a temp directory).
# RUN_DIR=.run
# LOG_DIR=scripts/logs/services
