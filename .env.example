# ─── OpenAI ───────────────────────────────────────────────────────────────────
# Needed only when the provider chain reaches OpenAI: LLM_PROVIDER=openai, or
# LLM_PROVIDER=auto when Ollama fails. The client is created on first use, so every
# service starts without a key. Without one, a call that reaches OpenAI fails with
# "OPENAI_API_KEY is not set" and the user sees "language model is misconfigured".
# With LLM_PROVIDER=ollama no key is needed.
# Get yours at: https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here

# ─── Ollama (local LLM — primary by default) ─────────────────────────────────
# LLM_PROVIDER controls which LLM is used:
#   auto   → try Ollama first; fall back to OpenAI if Ollama is unavailable (default)
#   ollama → Ollama only
#   openai → OpenAI only
LLM_PROVIDER=auto
OLLAMA_HOST=http://localhost:11434
# OLLAMA_MODEL defaults to llama3.2:1b in code when unset (DEFAULT_OLLAMA_MODEL).
OLLAMA_MODEL=llama3.2:1b

# Per-attempt timeout for one LLM request, in ms. Each caller also has an overall
# budget (router 15 s, synthesizer 60 s); an attempt never outlives what is left of it.
LLM_ATTEMPT_TIMEOUT_MS=20000

# ─── Orchestrator ─────────────────────────────────────────────────────────────
# How long a dispatched tool step may go unanswered before the plan fails with
# "The <tool> tool didn't respond within <n> s". One global value, in ms.
STEP_TIMEOUT_MS=30000

# ─── Process management ───────────────────────────────────────────────────────
# Where `bun run start` / the supervisor / `bun run stop` keep pid files and service logs.
# Defaults are shown; set both to run a second, separate copy (e.g. in a temp directory).
# RUN_DIR=.run
# LOG_DIR=scripts/logs/services
